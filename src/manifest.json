{
  "manifest_version": 3,
  "name": "hh helper: response counters",
  "version": "0.1.0",
  "description": "Shows vacancy response counters that hh.ru already sends to the browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hh-helper-ext@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://hh.ru/search/vacancy*", "https://hh.ru/vacancy/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["webRequest", "webRequestBlocking", "webRequestFilterResponse"],
  "host_permissions": ["https://hh.ru/*"]
}
